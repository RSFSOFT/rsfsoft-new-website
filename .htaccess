# RSF Soft — Performance, Security & Clean URLs (.htaccess)
Options -Indexes
ServerSignature Off

# ==========================================
# CLEAN URLS — Remove .html extension
# ==========================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect www to non-www (optional — remove if you want www)
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Remove .html extension from URLs
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^\.]+)$ $1.html [NC,L]

  # Redirect .html URLs to clean URLs
  RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
  RewriteRule ^ /%1 [NC,L,R=301]
</IfModule>

# ==========================================
# GZIP COMPRESSION
# ==========================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2 image/svg+xml
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4.0[678] no-gzip
  BrowserMatch bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# Brotli (if server supports it)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json font/woff2 image/svg+xml
</IfModule>

# ==========================================
# BROWSER CACHING
# ==========================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML — short cache for freshness
  ExpiresByType text/html "access plus 1 week"

  # CSS & JS — long cache (use versioned filenames for cache busting)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 2 years"
  ExpiresByType image/vnd.microsoft.icon "access plus 2 years"

  # Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # XML / JSON
  ExpiresByType application/xml "access plus 1 week"
  ExpiresByType text/xml "access plus 1 week"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/cache-manifest "access plus 0 seconds"
</IfModule>

# ==========================================
# CACHE-CONTROL HEADERS
# ==========================================
<IfModule mod_headers.c>
  # Immutable static assets — 1 year
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|svg|woff|woff2|ttf|otf|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML — 1 week
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=604800, must-revalidate"
  </FilesMatch>

  # Sitemap — 1 day
  <FilesMatch "sitemap\.xml$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # ---- Security Headers ----
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Remove ETag (already handled by Expires)
  Header unset ETag

  # CORS for fonts
  <FilesMatch "\.(ttf|otf|woff|woff2|eot)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # Keep-Alive
  Header set Connection keep-alive
</IfModule>

# ==========================================
# DISABLE ETags
# ==========================================
FileETag None

# ==========================================
# MIME TYPES
# ==========================================
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/javascript .mjs
  AddType text/cache-manifest .appcache
</IfModule>

# ==========================================
# ERROR DOCUMENTS
# ==========================================
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html

# ==========================================
# BLOCK BAD BOTS & PROTECT FILES
# ==========================================
<FilesMatch "(\.htaccess|\.htpasswd|\.git|composer\.(json|lock)|package\.json)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# ==========================================
# PERFORMANCE: PreFetch DNS
# ==========================================
<IfModule mod_headers.c>
  Header add Link "</css/styles.css>; rel=preload; as=style" "expr=%{REQUEST_URI} =~ m#^/$#"
  Header add Link "</css/pages.css>; rel=preload; as=style" "expr=%{REQUEST_URI} =~ m#^/$#"
</IfModule>
